	</Target>

	<Target Name="DeleteFoldersAfterBuild" AfterTargets="DeleteFilesAfterBuild">
		<RemoveDir Directories="$(Osx)" />
		<RemoveDir Directories="$(Win86)" />
		<RemoveDir Directories="$(WinARM)" />
	</Target>

